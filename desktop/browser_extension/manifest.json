{
  "manifest_version": 3,
  "name": "TB 浏览器连接",
  "version": "0.9.0",
  "description": "让 TB 使用当前浏览器已登录的竞赛平台提交代码并接收评测结果。",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*"], "js": ["pair.js"], "run_at": "document_idle"},
    {"matches": ["https://codeforces.com/*", "https://www.codeforces.com/*", "https://atcoder.jp/*", "https://ac.nowcoder.com/*", "https://www.luogu.com.cn/*", "https://luogu.com.cn/*"], "js": ["official.js", "main.js"], "world": "MAIN", "run_at": "document_start"},
    {"matches": ["https://codeforces.com/*", "https://www.codeforces.com/*", "https://atcoder.jp/*", "https://ac.nowcoder.com/*", "https://www.nowcoder.com/*", "https://nowcoder.com/*", "https://www.luogu.com.cn/*", "https://luogu.com.cn/*", "https://login.luogu.com.cn/*"], "js": ["content.js"], "run_at": "document_start"}
  ]
}
