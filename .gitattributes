# 行尾统一：文本文件入库一律 LF，只有 Windows 批处理留 CRLF（否则双击跑不了）
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.md  text eol=lf
*.py  text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.json text eol=lf
*.js  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve upstream license whitespace.
tools/tb_web/licenses/** -whitespace
tools/tb_web/THIRDPARTY.md -whitespace
